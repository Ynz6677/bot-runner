# Salin file ini menjadi ".env" lalu isi dengan data bot kamu
# JANGAN pernah share file .env ke siapapun / upload ke publik!

TOKEN=isi_token_bot_discord_disini
CLIENT_ID=isi_application_client_id_disini

# Opsional: isi GUILD_ID saat development supaya slash command
# ter-update INSTAN (tanpa GUILD_ID, command global butuh ~1 jam propagasi)
GUILD_ID=isi_id_server_testing_disini

# Opsional: lokasi custom file database.
# Default (jika dikosongkan): ~/storage/shared/storage-database (Internal Storage HP,
# aktif setelah kamu jalankan `termux-setup-storage` di Termux).
# DB_PATH=/storage/emulated/0/storage-database
